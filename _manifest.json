{
  "manifest_version": 2,
  "id": "github.Akenari011.maibot-manga",
  "version": "1.1.1",
  "name": "麦麦漫画",
  "description": "跨渠道漫画查询与推荐。支持拷贝漫画、G站漫画等站点，可按关键词或标签搜索并返回链接；封面可选本地打码，按群或私聊单独控制；每天定时从各渠道各抓一本，由 LLM 挑选后推送今日推荐。",
  "author": {
    "name": "Akenari011",
    "url": "https://github.com/Akenari011"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Akenari011/maibot-manga",
    "homepage": "https://github.com/Akenari011/maibot-manga",
    "issues": "https://github.com/Akenari011/maibot-manga/issues"
  },
  "host_application": {
    "min_version": "1.4.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.23.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "jmcomic",
      "version_spec": ">=2.7.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.20"
    },
    {
      "type": "python_package",
      "name": "zhconv",
      "version_spec": ">=1.4.0"
    }
  ],
  "changelog": "CHANGELOG.md",
  "plugin_type": "tool",
  "i18n": {
    "default_locale": "zh-CN"
  },
  "capabilities": [
    "send.text",
    "send.image",
    "send.hybrid",
    "send.forward",
    "llm.generate",
    "chat.get_all_streams"
  ],
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.jpg",
      "fallback": "image"
    }
  }
}
